# CrowdParty Server Environment Variables

# Port for the Node.js Socket.IO and Express server
PORT=4000

# Allowed CORS origins (comma-separated or * for development)
CORS_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Configuration (Optional - falls back to in-memory if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
